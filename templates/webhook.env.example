# Handler-bot webhook credentials for the grokbot-lark relay.
# Copy to ~/.lark-relay/webhook.env and chmod 600.
# Never commit this file or paste the key into chat.
#
# URL: the webhook URL shown on the handler bot's "Feishu message handling" (or
# equivalent) routine. The key is the bearer secret shown next to it. If you
# copied a full header such as `Authorization: Bearer <key>`, store only <key>.
LARK_BOT_WEBHOOK_URL=
LARK_BOT_WEBHOOK_KEY=
