# The handler routine's webhook: <relay dir>/webhook.env, mode 600.
# `scripts/onboard.py webhook` writes this file. Never commit it or paste the key into chat.
#
# Both values are shown in the routine's Webhook section on desktop: "POST to" is the URL, "key"
# is the bearer secret. A pasted "Authorization: Bearer <key>" header is reduced to <key>.
#
# The relay re-reads this file every two seconds, so no restart is needed. A value left empty
# here is taken from the environment variable of the same name.
LARK_BOT_WEBHOOK_URL=
LARK_BOT_WEBHOOK_KEY=
