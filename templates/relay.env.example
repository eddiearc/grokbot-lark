# Optional environment for the relay process (export these, or set them in the
# supervisor's environment). None of these are secrets, but the open_id and
# app id are unique to your app — do not commit real values.
#
# feishu = China (open.feishu.cn); larksuite = international (open.larksuite.com)
LARK_BRAND=feishu
#
# Bot identity, used to ignore the bot's own messages, detect @-mentions in
# groups, and label the bot in mention lists. Read them from the developer
# console or from an inbound event after the long connection is up.
LARK_BOT_OPEN_ID=
LARK_BOT_APP_ID=
LARK_BOT_NAME=
#
# Override the console URL if needed. Defaults follow LARK_BRAND.
# LARK_CONSOLE_URL=
#
# Override the path to the bot-only wrapper. Defaults to this relay directory.
# LARK_BOT_CLI=
