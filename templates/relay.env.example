# Settings for one relay: <relay dir>/relay.env. `scripts/onboard.py relay` writes this file.
# supervisor.sh, start.sh and status.sh load it on every start, so the settings survive
# restarts. Shell syntax: quote values that contain spaces. Nothing here is secret.
#
# This bot's isolated lark-cli store. One relay directory serves exactly one bot.
LARK_BOT_ENV=${HOME}/.lark-bots/lark-bot/env.sh
#
# feishu = China (open.feishu.cn); lark = international (open.larksuite.com).
LARK_BRAND=feishu
#
# The bot's own identity. The relay uses it to ignore the bot's own messages and to detect
# @mentions in groups; without LARK_BOT_OPEN_ID, group @mentions are never forwarded.
LARK_BOT_APP_ID=
LARK_BOT_OPEN_ID=
LARK_BOT_NAME=
#
# Optional. Where the operator grants permissions; defaults to the app's permission page.
# LARK_CONSOLE_URL=
#
# Optional. The webhook URL may live here, since it is useless without the key. Keep the key
# in webhook.env or in the relay's environment.
# LARK_BOT_WEBHOOK_URL=
