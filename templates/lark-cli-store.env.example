# Isolated lark-cli store for one Grok Bot. This file contains no secrets.
# Copy to ~/.lark-bots/<bot-name>/env.sh (mode 600) and adjust the paths.
# Source it before every lark-cli call, and have the relay supervisor source
# it too (or set LARK_BOT_ENV to this file).
#
# Usage:
#   source "$HOME/.lark-bots/lark-bot/env.sh" && lark-cli ... --as bot
#
export PATH="${HOME}/.local/bin:${PATH}"
export LARKSUITE_CLI_CONFIG_DIR="${HOME}/.lark-bots/lark-bot/config"
export LARKSUITE_CLI_DATA_DIR="${HOME}/.lark-bots/lark-bot/data"
export LARKSUITE_CLI_LOG_DIR="${HOME}/.lark-bots/lark-bot/logs"
