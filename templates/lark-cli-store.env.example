# One bot's isolated lark-cli store: ~/.lark-bots/<bot>/env.sh, mode 600.
# `scripts/onboard.py app` writes this file. It holds no secrets: the app credentials are kept
# by lark-cli inside the data directory.
#
# Source it before every lark-cli call:
#   source "$HOME/.lark-bots/lark-bot/env.sh" && lark-cli ... --as bot
#
export PATH="${HOME}/.local/bin:${PATH}"
export LARKSUITE_CLI_CONFIG_DIR="${HOME}/.lark-bots/lark-bot/config"
export LARKSUITE_CLI_DATA_DIR="${HOME}/.lark-bots/lark-bot/data"
export LARKSUITE_CLI_LOG_DIR="${HOME}/.lark-bots/lark-bot/logs"
