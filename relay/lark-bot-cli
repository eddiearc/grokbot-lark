#!/usr/bin/env python3
"""Force lark-cli to use bot identity. Rejects --as user. Does not touch stored user tokens."""

from __future__ import annotations

import os
import sys
from pathlib import Path


def split_as(argv: list[str]) -> tuple[list[str], str | None]:
    out: list[str] = []
    as_value: str | None = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--as":
            if i + 1 >= len(argv):
                print(
                    "lark-bot-cli: --as requires a value (bot). --as user is not allowed.",
                    file=sys.stderr,
                )
                sys.exit(2)
            as_value = argv[i + 1]
            i += 2
            continue
        if a.startswith("--as="):
            as_value = a.split("=", 1)[1]
            i += 1
            continue
        out.append(a)
        i += 1
    return out, as_value


def main() -> None:
    home_bin = str(Path.home() / ".local" / "bin")
    path = os.environ.get("PATH", "")
    if home_bin not in path.split(":"):
        os.environ["PATH"] = home_bin + ":" + path

    lark = Path.home() / ".local" / "bin" / "lark-cli"
    lark_bin = str(lark) if lark.is_file() else "lark-cli"

    rest, as_value = split_as(sys.argv[1:])
    if as_value is not None and as_value.strip().lower() == "user":
        print(
            "lark-bot-cli: refusing --as user. Lark Bot may only call lark-cli as bot identity.",
            file=sys.stderr,
        )
        sys.exit(2)

    cmd = [lark_bin, *rest, "--as", "bot"]
    os.execvp(cmd[0], cmd)


if __name__ == "__main__":
    main()
